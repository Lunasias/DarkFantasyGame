# ---------------------------------------------------------------------------
# DarkFantasyGame — environment variables (example only, never commit real values)
# Copy this file to `.env.local` and fill in your own values.
# ---------------------------------------------------------------------------

# Neon PostgreSQL connection string (used by Drizzle ORM / serverless driver).
# Format: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-host/darkfantasy?sslmode=require"

# Public URL of the deployed app (used for server-side link building).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
